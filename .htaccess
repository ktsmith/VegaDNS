# Apache 2.4, mod_rewrite; set AllowOverride FileInfo Options in the vhost.
# Only the front controller and stylesheet are public. No PHP-FPM php_flag rules.
Options -Indexes -MultiViews
DirectoryIndex index.php
AcceptPathInfo Off
RewriteEngine On
RewriteRule ^(?:index\.php|assets/app\.css)?$ - [END]
RewriteRule ^ - [R=404,END]
